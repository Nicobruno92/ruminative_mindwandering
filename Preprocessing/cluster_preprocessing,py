log_preprocessing.log_detail("len_autoreject_epochs", len(ar_reject_epochs))

# %%
# epochs_clean = epochs  # to skip autoreject
# ar_reject_epochs = []  # to skip autoreject
#Manually inspect and reject bad epochs
