# baseline correction should be done after ICA
epochs = mne.Epochs(
    raw_filtered,
    events=events,
    event_id=go_nogo_event_id,
    tmin=tmin,
    tmax=tmax,
    preload=False,
    verbose=False,
)

# Save the epoched data
